{
  "name": "thai-accounting",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap run android",
    "cap:ios": "npm run build && cap sync ios && cap open ios",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts && prettier --write src/lib/database.types.ts"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.6.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "@fontsource/sarabun": "^5.3.0",
    "@hookform/resolvers": "^7.0.9",
    "@react-pdf/renderer": "^4.9.1",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "i18next": "^27.2.7",
    "i18next-browser-languagedetector": "^8.3.1",
    "lucide-react": "^1.79.0",
    "papaparse": "^5.7.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^3.4.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
